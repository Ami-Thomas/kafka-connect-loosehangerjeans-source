{
  "namespace": "com.loosehangerjeans",
  "type": "record",
  "name": "AbandonedShoppingCart",
  "fields": [
    {
      "name": "id",
      "doc": "Unique ID for the abandoned shopping cart",
      "type": {
        "type": "string",
        "logicalType": "uuid"
      }
    },
    {
      "name": "customer",
      "doc": "Customer who abandoned products in the shopping cart",
      "type": {
        "type": "record",
        "name": "Customer",
        "fields": [
          {
            "name": "id",
            "type": {
              "type": "string",
              "logicalType": "uuid"
            },
            "doc": "Unique id for the customer"
          },
          {
            "name": "name",
            "type": "string",
            "doc": "Name of the customer"
          },
          {
            "name": "emails",
            "type": {
              "type": "array",
              "items": "string"
            },
            "doc": "Emails of the customer"
          }
        ]
      }
    },
    {
      "name": "products",
      "doc": "Descriptions of the abandoned shopping cart products",
      "type": {
        "type": "array",
        "items": "string"
      }
    },
    {
      "name": "abandontime",
      "doc": "Time that the products were abandoned in the shopping cart (UTC time in ISO 8601 format)",
      "type": "string"
    }
  ]
}